prefix="@_pc_prefix_expr@"
exec_prefix="${prefix}"
libdir="@_pc_libdir_expr@"
includedir="@_pc_includedir_expr@"

Name: dbmw
Description: C++17 database middleware - pooled connections, heartbeat, multi-driver (MySQL/PostgreSQL/ODBC)
URL: https://github.com/matergreen/dbmw
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldbmw
Cflags: -I${includedir}
